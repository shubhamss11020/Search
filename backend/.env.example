# Backend Environment Configuration

# Application
PROJECT_NAME="AI Job Search & Application Assistant"
ENVIRONMENT="development" # development | production
DEBUG=True
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","chrome-extension://*"]

# Security
JWT_SECRET="change-this-to-a-super-secret-random-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days for personal use convenience

# Neon PostgreSQL Database
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/profile_search"

# LLM Providers (Grok & Gemini Free Tier)
# Google Gemini free tier API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# xAI Grok API key (optional)
GROK_API_KEY=""
GROK_MODEL="grok-beta"

# Preferred LLM ("gemini" or "grok")
ACTIVE_LLM="gemini"

# Storage Configuration (Local disk fallback or S3/Cloudflare R2)
STORAGE_MODE="local" # "local" or "s3"
UPLOAD_DIR="./uploads"

# S3 Configuration (only needed if STORAGE_MODE=s3)
S3_BUCKET_NAME=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
S3_ENDPOINT_URL=""
